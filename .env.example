# ============================================================
# InferaV22 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=inferav22
POSTGRES_PASSWORD=change_me_before_deploy_DO_NOT_USE_DEFAULT
POSTGRES_DB=inferav22
DATABASE_URL=postgresql://inferav22:change_me_before_deploy_DO_NOT_USE_DEFAULT@postgres:5432/inferav22

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=generate_a_random_256_bit_secret_do_not_hardcode
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ── HuggingFace ───────────────────────────────────────────────
# Required for gated models (e.g., Llama 3.x)
HF_TOKEN=

# ── Inference Endpoints ───────────────────────────────────────
# Set these to running llama-server instances on real Arm hardware.
# Deploy using: deploy/Dockerfile.llamacpp-arm
GRAVITON4_INFERENCE_URL=
COBALT100_INFERENCE_URL=
AXION_INFERENCE_URL=

# ── Cloud Pricing (USD/hour per instance) ─────────────────────
GRAVITON4_HOURLY_COST=0.46
COBALT100_HOURLY_COST=0.48
AXION_HOURLY_COST=0.49
X86_XEON_HOURLY_COST=0.85

# ── Model Storage ─────────────────────────────────────────────
MODEL_CACHE_DIR=/models/cache

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
WORKER_CONCURRENCY=4

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me

# ── Certificate Verification ──────────────────────────────────
VERIFY_BASE_URL=https://verify.inferav22.dev
